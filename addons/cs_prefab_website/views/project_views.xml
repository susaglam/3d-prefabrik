<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        De achterkant van de projectgalerij.

        Het menu hangt onder Website, want daar hoort het thuis: iemand die foto's bijwerkt is
        met de site bezig, niet met een aparte applicatie. Het module heeft daarom ook geen eigen
        startpictogram; een tweede tegel op het startscherm voor één lijst is ruis.

        De velden Naam, Plaats, Jaar en Verhaal staan hier LEEG klaar. Dat is geen vergetelheid:
        de oude site draagt ze niet, dus ze zijn niet ingevuld. Wat de klant hier intypt, staat
        meteen op de galerij; zolang er niets staat, toont de galerij alleen de foto's — precies
        zoals de oude site.
    -->

    <record id="view_prefab_project_list" model="ir.ui.view">
        <field name="name">cs.prefab.project.list</field>
        <field name="model">cs.prefab.project</field>
        <field name="arch" type="xml">
            <list string="Fotoreeksen" default_order="sequence, id">
                <field name="sequence" widget="handle"/>
                <field name="display_name" string="Reeks"/>
                <field name="name" string="Naam" optional="show"/>
                <field name="location"/>
                <field name="year" optional="show"/>
                <field name="image_count" string="Foto's"/>
                <field name="is_published" widget="boolean_toggle"/>
                <field name="website_id" groups="website.group_multi_website" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_prefab_project_kanban" model="ir.ui.view">
        <field name="name">cs.prefab.project.kanban</field>
        <field name="model">cs.prefab.project</field>
        <field name="arch" type="xml">
            <!--
                Bewust zonder omslagfoto. Een kaart met een <img> uit een gerelateerd record
                vraagt om record.<veld>.raw_value plus een expliciete <field>-declaratie, en de
                vorm daarvan is precies wat tussen Odoo-versies verschuift. Het is een tweede
                weergave naast de lijst; het is de moeite van een niet-testbare constructie
                niet waard.
            -->
            <kanban default_order="sequence, id">
                <templates>
                    <t t-name="card">
                        <div class="fw-bold fs-5"><field name="display_name"/></div>
                        <div class="text-muted">
                            <field name="location"/>
                        </div>
                        <div class="mt-2">
                            <field name="image_count" string="Foto's"/>
                            <field name="is_published" widget="boolean_toggle"/>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_prefab_project_form" model="ir.ui.view">
        <field name="name">cs.prefab.project.form</field>
        <field name="model">cs.prefab.project</field>
        <field name="arch" type="xml">
            <form string="Fotoreeks">
                <header>
                    <button name="open_website_url" type="object" string="Bekijk de galerij"
                            class="btn-secondary" invisible="not is_published"
                            help="Opent de galerij op de website in een nieuw tabblad, precies zoals een bezoeker hem ziet. Controleer hier altijd even of de foto's in de goede volgorde staan."/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Nog geen naam — laat gerust leeg"/></h1>
                    </div>
                    <group>
                        <group name="wat">
                            <field name="location" placeholder="bijv. Den Haag"/>
                            <field name="year" placeholder="bijv. 2025"/>
                        </group>
                        <group name="web">
                            <field name="sequence"/>
                            <field name="image_count"/>
                            <field name="is_published" widget="boolean_toggle"/>
                            <field name="website_id" groups="website.group_multi_website"/>
                        </group>
                    </group>
                    <group string="Verhaal bij deze reeks">
                        <field name="story" nolabel="1"
                               placeholder="Een paar zinnen die de bezoeker ziet als hij een foto van deze reeks groter opent. Laat leeg als er nog geen verhaal is — een lege vergroting is beter dan een verzonnen verhaal."/>
                    </group>
                    <notebook>
                        <page string="Foto's" name="fotos">
                            <field name="image_ids">
                                <list string="Foto's" editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="image" widget="image" options="{'size': [90, 60]}"/>
                                    <field name="alt" placeholder="bijv. Afgeronde aanbouw met een lichtstraat over de volle breedte"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_prefab_project_search" model="ir.ui.view">
        <field name="name">cs.prefab.project.search</field>
        <field name="model">cs.prefab.project</field>
        <field name="arch" type="xml">
            <search string="Fotoreeksen">
                <field name="name" string="Naam of plaats"
                       filter_domain="['|', ('name', 'ilike', self), ('location', 'ilike', self)]"/>
                <filter name="gepubliceerd" string="Gepubliceerd" domain="[('is_published', '=', True)]"/>
                <filter name="concept" string="Nog niet gepubliceerd" domain="[('is_published', '=', False)]"/>
                <filter name="zonder_naam" string="Zonder naam"
                        domain="[('name', 'in', (False, ''))]"/>
                <!--
                    🪤 GEEN <separator/> EN GEEN <group expand="0"> in een zoekweergave op deze
                    reeks. Allebei laten ze de view-validatie vallen met "Ongeldige weergave …
                    definitie", en de melding noemt de oorzaak niet — alleen het bestand en het
                    regelnummer. Het groepeerfilter staat daarom los.
                -->
                <filter name="groep_plaats" string="Plaats" context="{'group_by': 'location'}"/>
            </search>
        </field>
    </record>

    <record id="action_prefab_project" model="ir.actions.act_window">
        <field name="name">Projectfoto's</field>
        <field name="res_model">cs.prefab.project</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="view_prefab_project_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Zet je eerste foto's online
            </p>
            <p>
                De pagina Projecten is een galerij: één raster met alle foto's, precies zoals op
                de oude site. Een reeks is de doos eromheen — de foto's van één bouw bij elkaar,
                zodat je de plaats, het jaar en het verhaal één keer invult en niet bij elke foto
                opnieuw.
            </p>
            <p>
                Naam, plaats, jaar en verhaal mogen leeg blijven: wat leeg is, toont de site niet.
                Vul je ze in, dan verschijnen ze onder de foto's van die reeks en in de vergroting
                die een bezoeker opent als hij op een foto klikt.
            </p>
            <p>
                Beschrijf elke foto wél in één zin. Die beschrijving is wat iemand hoort die de
                foto niet kan zien, en wat Google leest — daarom is het veld verplicht.
            </p>
        </field>
    </record>

    <!--
        Een groepsmenu draagt zelf geen action: op een touchscreen navigeert een tik dan in
        plaats van het submenu te openen, en de kinderen worden volledig onbereikbaar.
        "Website" is hier geen groepsmenu maar het bestaande hoofdmenu van de website-app, dus
        dit item is een blad en mag zijn action houden.
    -->
    <menuitem id="menu_prefab_project"
              name="Projectfoto's"
              parent="website.menu_content"
              action="action_prefab_project"
              sequence="25"/>

</odoo>
