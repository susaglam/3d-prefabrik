<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_prefab_quote_list" model="ir.ui.view">
    <field name="name">cs.prefab.quote.list</field>
    <field name="model">cs.prefab.quote</field>
    <field name="arch" type="xml">
      <list create="false" delete="false">
        <field name="name"/><field name="create_date"/><field name="website_id"/>
        <field name="lead_id"/><field name="pricebook_version"/><field name="state"/>
        <field name="company_id" groups="base.group_multi_company"/>
      </list>
    </field>
  </record>
  <record id="view_prefab_quote_form" model="ir.ui.view">
    <field name="name">cs.prefab.quote.form</field>
    <field name="model">cs.prefab.quote</field>
    <field name="arch" type="xml">
      <form create="false" delete="false">
        <header><button name="action_open_lead" string="Open CRM-aanvraag" type="object" class="oe_highlight" invisible="not lead_id"/><field name="state" widget="statusbar"/></header>
        <sheet>
          <div class="alert alert-warning" role="alert">Demonstratieprijs. Technische haalbaarheid en commerciële prijs moeten worden beoordeeld.</div>
          <h1><field name="name"/></h1>
          <group><field name="company_id"/><field name="website_id"/><field name="lead_id"/><field name="pricebook_version"/><field name="total_cents" string="Totaal incl. btw (eurocenten)"/><field name="expires_at"/></group>
          <notebook><page string="Opgeslagen configuratie en prijs"><field name="snapshot_json"/></page><page string="Contact en toestemming"><field name="contact_json"/></page></notebook>
        </sheet>
      </form>
    </field>
  </record>
  <record id="action_prefab_quote" model="ir.actions.act_window"><field name="name">Prefab aanvragen</field><field name="res_model">cs.prefab.quote</field><field name="view_mode">list,form</field></record>
  <menuitem id="menu_prefab_root" name="Prefab" sequence="45" groups="sales_team.group_sale_salesman"/>
  <menuitem id="menu_prefab_quotes" name="Aanvragen" parent="menu_prefab_root" action="action_prefab_quote"/>
</odoo>
