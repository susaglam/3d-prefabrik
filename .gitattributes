* text=auto eol=lf
*.bat text eol=crlf
# Preserve upstream evidence and vendored libraries verbatim.
research/reference/** -text -whitespace
addons/cs_prefab_configurator/static/vendor/** -text -whitespace
addons/cs_prefab_configurator/services/fonts/** -text -whitespace
*.png binary
*.pdf binary
*.ttf binary
*.woff2 binary
# Site media. Git's own detection would almost certainly classify these as binary anyway,
# but the packager records a sha256 per file and the deploy compares it against the
# installed copy, so a single mis-detected file that got line-ending normalisation would
# be a corrupt image the pipeline reports as a mismatch rather than as a bad picture.
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.mp4 binary
