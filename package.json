{
  "name": "cs-prefab-configurator",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "CS Prefab: guided extension configurator with shared Python/Odoo quote engine",
  "scripts": {
    "vendor": "node scripts/vendor.mjs",
    "start": "python3 scripts/serve.py",
    "test": "node --test tests/frontend/*.test.mjs",
    "test:browser": "node scripts/verify-browser.mjs",
    "test:interactions": "node scripts/verify-interactions.mjs",
    "test:accessibility": "node scripts/verify-accessibility.mjs"
  },
  "dependencies": {
    "three": "0.180.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.58.2"
  }
}
