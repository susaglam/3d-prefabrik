{
  "name": "cs-prefab-configurator",
  "version": "2.16.0",
  "private": true,
  "type": "module",
  "description": "CS Prefab: guided extension configurator with shared Python/Odoo quote engine",
  "scripts": {
    "vendor": "node scripts/vendor.mjs",
    "start": "python3 scripts/serve.py",
    "test": "node --max-old-space-size=2048 --test --test-concurrency=2 tests/frontend/*.test.mjs",
    "test:browser": "node scripts/verify-browser.mjs",
    "test:interactions": "node scripts/verify-interactions.mjs",
    "test:accessibility": "node scripts/verify-accessibility.mjs",
    "test:documents": "node scripts/verify-document-capture.mjs",
    "test:embed": "node scripts/verify-embed.mjs",
    "test:rendering": "node scripts/verify-rendering.mjs",
    "preview:website": "python scripts/preview_website.py",
    "test:website": "node scripts/verify-website.mjs"
  },
  "dependencies": {
    "three": "0.180.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.58.2",
    "esbuild": "0.25.12",
    "sass": "^1.93.2"
  }
}
